---
import {
  TRIAL_STATUS_LABELS,
  TRIAL_STATUS_SOURCE_LABELS,
  TRIAL_STATUS_TONE,
  type TrialStatus,
  type TrialStatusSource,
} from '../lib/vocab';
import { formatDate } from '../lib/derive';

interface Trial {
  nctId: string;
  phase: string;
  status: TrialStatus;
  statusSource: TrialStatusSource;
  condition: string;
  enrolment: { count: number; basis: 'actual' | 'estimated' };
  verified: Date;
}
interface Props {
  trials: Trial[];
}
const { trials } = Astro.props;
const anyUnknown = trials.some((t) => t.status === 'unknown');
---

<div class="card print-entry p-4 text-sm">
  <h2 class="text-xs font-semibold uppercase tracking-wide" style="color: var(--text-faint);">
    Registered trials
  </h2>

  <ul class="mt-3 space-y-3">
    {
      trials.map((t) => (
        <li>
          <p class="flex flex-wrap items-center gap-2">
            <span
              class:list={[
                'badge',
                TRIAL_STATUS_TONE[t.status] === 'caution' ? 'stale-stale' : 'badge-neutral',
              ]}
            >
              Phase {t.phase} · {TRIAL_STATUS_LABELS[t.status]}
            </span>
            <a class="citation-link font-mono text-xs" href={`https://clinicaltrials.gov/study/${t.nctId}`} rel="noopener">
              {t.nctId}
            </a>
          </p>
          <p class="mt-1" style="color: var(--text-muted);">
            {t.condition} ·{' '}
            {t.enrolment.basis === 'actual'
              ? `${t.enrolment.count} participants enrolled`
              : `${t.enrolment.count} planned — no final figure reported`}
          </p>
          <p class="text-xs" style="color: var(--text-faint);">
            Read from {TRIAL_STATUS_SOURCE_LABELS[t.statusSource]} on {formatDate(t.verified)}
          </p>
        </li>
      ))
    }
  </ul>

  {
    anyUnknown && (
      <p class="mt-3 leading-relaxed" style="color: var(--text-muted);">
        “Status unknown” is the registry's own flag for a record whose sponsor stopped
        updating it past the expected completion date. Where the enrolment figure is a
        plan rather than a count, nobody has reported what actually happened. Secondary
        trackers tend to keep showing the last confident-sounding status instead.
      </p>
    )
  }
</div>
