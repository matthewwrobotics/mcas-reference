---
import { DIRECT_EVIDENCE_INFO, type DirectEvidence } from '../lib/vocab';
import { href } from '../lib/paths';

interface Props {
  level: DirectEvidence;
  short?: boolean;
  link?: boolean;
}
const { level, short = false, link = true } = Astro.props;
const info = DIRECT_EVIDENCE_INFO[level];
const label = short ? info.short : info.label;
const Tag = link ? 'a' : 'span';
---

<Tag
  class:list={['badge', `direct-${level}`]}
  {...link ? { href: href(`/methodology#direct-${level}`) } : {}}
  title={info.definition}
>
  <span class="sr-only">Direct MCAS evidence:</span>{label}
</Tag>
