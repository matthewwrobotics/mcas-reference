---
import EvidenceRows from './EvidenceRows.astro';
import LastVerified from './LastVerified.astro';
import TreatmentFacts from './TreatmentFacts.astro';
import { byClinicalSequence } from '../lib/derive';
import {
  TREATMENT_CONTEXT_INFO,
  TREATMENT_CONTEXTS,
  TREATMENT_STEP_INFO,
  TREATMENT_STEPS,
  type TreatmentContext,
  type TreatmentStep,
} from '../lib/vocab';
import { href } from '../lib/paths';

interface Props {
  entries: any[];
  basePath: string;
}
const { entries, basePath } = Astro.props;
// Shared with the appointment picker so the two orderings cannot drift apart.
// Groups below re-filter this list, so the sequence rank is a no-op here; what
// matters is stepOrder ahead of the internal direct-study rank within a step.
const sorted = [...entries].sort((a, b) => byClinicalSequence(a.data, b.data));

// Grouped by the sequence a published management review describes, because
// that is the order a reader is likely to meet these in. Within each step, the
// source's explicit stepOrder leads where present, then the internal direct-
// mast-cell study rank described on /methodology.
// Anything outside that sequence — the KIT
// inhibitors, emerging refractory reports, every supplement — is explicitly
// placed rather than being silently ranked against the routine sequence.
const steps = (TREATMENT_STEPS as readonly TreatmentStep[])
  .map((step) => ({
    key: `step-${step}`,
    title: `${step}. ${TREATMENT_STEP_INFO[step].label}`,
    detail: TREATMENT_STEP_INFO[step].described,
    items: sorted.filter((e) => e.data.treatmentStep === step),
  }))
  .filter((g) => g.items.length > 0);

const unsequenced = sorted.filter((e) => !e.data.treatmentStep);
const contextGroups = (TREATMENT_CONTEXTS as readonly TreatmentContext[])
  .map((context) => ({
    key: context,
    title: TREATMENT_CONTEXT_INFO[context].groupTitle,
    detail: TREATMENT_CONTEXT_INFO[context].groupDetail,
    position: TREATMENT_CONTEXT_INFO[context].indexPosition,
    items: unsequenced.filter((e) => e.data.treatmentContext === context),
  }))
  .filter((group) => group.items.length > 0);
const otherUnsequenced = unsequenced.filter(
  (e) => !e.data.treatmentContext,
);
const groups = [
  ...contextGroups.filter((group) => group.position === 'before-steps'),
  ...steps,
  ...contextGroups.filter((group) => group.position === 'after-steps'),
  ...(otherUnsequenced.length
    ? [{
        key: 'unsequenced',
        title: 'Outside that sequence',
        detail: 'not part of the stepwise approach the review describes',
        items: otherUnsequenced,
      }]
    : []),
];
---

{
  groups.map((group) => (
    <section class="mt-8">
      <h2 class="text-sm font-semibold" id={`group-${group.key}`}>
        {group.title}
        <span class="ml-2 font-normal" style="color: var(--text-faint);">
          — {group.detail}
        </span>
      </h2>

      <ul class="mt-3 space-y-3">
        {group.items.map((entry) => (
          <li class="card p-4">
            <h3 class="text-lg font-semibold">
              <a
                href={href(`${basePath}/${entry.id}`)}
                class="no-underline hover:underline"
                style="color: var(--text);"
              >
                {entry.data.name}
              </a>
              <span class="ml-2 text-sm font-normal" style="color: var(--text-faint);">
                {entry.data.mechanismClass}
              </span>
            </h3>

            <TreatmentFacts
              basis={entry.data.mastCellBasis}
              studyDesigns={entry.data.studyDesigns}
              regulatory={entry.data.regulatory}
            />

            <p class="mt-1.5 max-w-prose text-sm" style="color: var(--text-muted);">
              {entry.data.summary}
            </p>

            {/* Kept in one component so the two facts cannot drift apart. */}
            <EvidenceRows
              basis={entry.data.mastCellBasis}
              classMembers={entry.data.classMembers}
              studyDesigns={entry.data.studyDesigns}
              establishedFor={entry.data.establishedFor}
              specialistUse={entry.data.specialistUse}
              treatmentContext={entry.data.treatmentContext}
              regulatory={entry.data.regulatory}
              compact
            />

            <p class="mt-2.5 flex flex-wrap items-center gap-2 text-xs">
              <LastVerified date={entry.data.lastVerified} compact />
              {entry.data.trials.some((trial: any) => trial.status === 'unknown') && (
                <span class="badge stale-stale">Trial status unknown</span>
              )}
            </p>
          </li>
        ))}
      </ul>
    </section>
  ))
}
