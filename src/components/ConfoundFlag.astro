---
import type { ConfoundLevel } from '../lib/vocab';

interface Props {
  level: ConfoundLevel;
  note: string;
}
const { level, note } = Astro.props;
---

<aside
  class="print-entry rounded-lg border p-4 text-sm"
  style="background: var(--flag-bg); color: var(--flag-fg); border-color: var(--flag-border);"
>
  <p class="font-semibold">
    Confound risk: {level}
  </p>
  <p class="mt-1.5 leading-relaxed">{note}</p>
</aside>
