---
import {
  ESTABLISHED_BASIS_INFO,
  MAST_CELL_BASIS_INFO,
  SPECIALIST_USE_BASIS_INFO,
  TREATMENT_CONTEXT_INFO,
  type StudyDesign,
  type SpecialistUseBasis,
  type TreatmentContext,
  REGULATORY_INFO,
  type EstablishedBasis,
  type MastCellBasis,
  type RegulatoryStatus,
} from '../lib/vocab';
import StudyDesignLinks from './StudyDesignLinks.astro';
import { href } from '../lib/paths';

interface Established {
  condition: string;
  basis: EstablishedBasis;
}
interface SpecialistUse {
  basis: SpecialistUseBasis;
  provenance: string;
  sourceUrl: string;
}
interface Props {
  basis: MastCellBasis;
  classMembers?: string[];
  studyDesigns: StudyDesign[];
  establishedFor: Established[];
  specialistUse: SpecialistUse[];
  treatmentContext?: TreatmentContext;
  regulatory: RegulatoryStatus;
  compact?: boolean;
}
const {
  basis,
  classMembers = [],
  studyDesigns,
  establishedFor,
  specialistUse,
  treatmentContext,
  regulatory,
  compact = false,
} = Astro.props;
const info = MAST_CELL_BASIS_INFO[basis];

// Group by basis so the label is written once per group rather than repeated
// against every condition.
const groups = (['approved-us', 'approved-non-us', 'randomised-trials'] as const)
  .map((b) => ({
    basis: b,
    label: ESTABLISHED_BASIS_INFO[b].label,
    conditions: establishedFor.filter((e) => e.basis === b).map((e) => e.condition),
  }))
  .filter((g) => g.conditions.length > 0);

// Approval status only matters here when there is nothing to list — otherwise
// the conditions above already say it, in more useful detail.
const fallback = groups.some((g) => g.basis.startsWith('approved'))
  ? null
  : REGULATORY_INFO[regulatory].label;
---

<!--
  Full entries keep relationship, study design and condition facts together.
  Compact cards receive the first two from TreatmentFacts immediately above,
  while this component keeps named conditions directly below the card summary.
  An earlier version put the mast cell row in a card's header and the conditions
  in its footer, with the summary paragraph between; entries then read as
  "Ketotifen … randomised trials — allergic conjunctivitis and asthma", which is
  the inference the split exists to prevent.
-->
<dl class:list={['evidence-rows', compact && 'evidence-rows-compact']}>
  {
    /* Compact cards state this in TreatmentFacts immediately above. Detail
       pages use the full two-row version here. */
    !compact && (
      <div>
        <dt>How it relates to mast cells</dt>
        <dd>
          <a href={href(`/methodology#basis-${basis}`)} class="evidence-key">{info.label}</a>
        </dd>
      </div>
    )
  }

  {
    !compact && studyDesigns.length > 0 && (
      <div>
        <dt>Types of studies cited</dt>
        <dd class="evidence-gloss">
          <StudyDesignLinks designs={studyDesigns} />
        </dd>
      </div>
    )
  }

  {
    groups.map((g) => (
      <div>
        <dt>
          <a
            href={href(
              g.basis === 'randomised-trials'
                ? '/glossary#randomised-controlled-trial'
                : '/glossary#approved',
            )}
          >
            {g.label}
          </a>
        </dt>
        <dd>{g.conditions.join(', ')}</dd>
      </div>
    ))
  }

  {
    treatmentContext && (
      <div>
        <dt>Catalog context</dt>
        <dd>
          <a
            href={href(`/methodology#context-${treatmentContext}`)}
            class="badge badge-neutral"
          >
            {TREATMENT_CONTEXT_INFO[treatmentContext].label}
          </a>
        </dd>
      </div>
    )
  }

  {
    classMembers.length > 0 && (
      <div>
        <dt>Also covers</dt>
        <dd class="evidence-gloss">{classMembers.join(', ')}</dd>
      </div>
    )
  }

  {
    specialistUse.length > 0 && (
      <div>
        <dt>Clinical practice</dt>
        <dd>
          <a href={href('/methodology#specialist-use')} class="badge badge-specialist">
            Documented specialist use
          </a>
          {
            !compact && specialistUse.map((signal) => (
              <span class="mt-1 block text-xs evidence-gloss">
                {signal.provenance} ·{' '}
                <a href={signal.sourceUrl}>{SPECIALIST_USE_BASIS_INFO[signal.basis].label}</a>
              </span>
            ))
          }
        </dd>
      </div>
    )
  }

  {
    fallback && (
      <div>
        <dt><a href={href('/glossary#approved')}>Approved for</a></dt>
        <dd>
          <span class="evidence-gloss">
            nothing —{' '}
            {regulatory === 'dietary-supplement' ? (
              <a href={href('/glossary#dietary-supplement')}>{fallback}</a>
            ) : (
              fallback
            )}
          </span>
        </dd>
      </div>
    )
  }

  {
    /* Whether a reader can buy it today, stated on the entry as well as the
       card. Shown only when true — the absence of this row is not a claim that
       something is prescription-only, which the data does not yet record. */
    !compact && regulatory === 'otc' && (
      <div>
        <dt>Availability</dt>
        <dd>
          <span class="evidence-gloss">
            sold over the counter in the US, without a prescription
          </span>
        </dd>
      </div>
    )
  }
</dl>
