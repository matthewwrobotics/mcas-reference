---
import {
  TRIAL_STATUS_LABELS,
  TRIAL_STATUS_TONE,
  TRIAL_STATUS_SOURCE_LABELS,
  type TrialStatus,
  type TrialStatusSource,
} from '../lib/vocab';
import { formatDate, staleness, STALENESS_LABELS } from '../lib/derive';

interface Props {
  nctId: string;
  status: TrialStatus;
  statusSource: TrialStatusSource;
  verified: Date;
}
const { nctId, status, statusSource, verified } = Astro.props;
const { level, days } = staleness(verified);
const tone = TRIAL_STATUS_TONE[status];
---

<div class="card print-entry p-4 text-sm">
  <h2 class="text-xs font-semibold uppercase tracking-wide" style="color: var(--text-faint);">
    Trial status
  </h2>
  <p class="mt-2 flex flex-wrap items-center gap-2">
    <span class:list={['badge', tone === 'caution' ? 'stale-stale' : 'badge-neutral']}>
      {TRIAL_STATUS_LABELS[status]}
    </span>
    {level !== 'fresh' && (
      <span class:list={['badge', `stale-${level}`]}>{STALENESS_LABELS[level]}</span>
    )}
    <a
      class="citation-link font-mono text-xs"
      href={`https://clinicaltrials.gov/study/${nctId}`}
      rel="noopener">{nctId}</a
    >
  </p>
  {
    status === 'unknown' && (
      <p class="mt-2 leading-relaxed" style="color: var(--text-muted);">
        “Status unknown” is the registry’s own flag for a record its sponsor has not
        updated past the study’s expected completion date. It does not mean the study
        is ongoing, and secondary trackers often continue to show an older, more
        confident-looking status here.
      </p>
    )
  }
  <p class="mt-2 text-xs" style="color: var(--text-faint);">
    Read from {TRIAL_STATUS_SOURCE_LABELS[statusSource]} on {formatDate(verified)}
    ({days} day{days === 1 ? '' : 's'} ago). This site does not take trial statuses from
    aggregator sites.
  </p>
</div>
