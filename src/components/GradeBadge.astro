---
import { RELEVANCE_GRADE_INFO, type RelevanceGrade } from '../lib/vocab';
import { href } from '../lib/paths';

interface Props {
  grade: RelevanceGrade;
  approved: boolean;
  short?: boolean;
}
const { grade, approved, short = false } = Astro.props;
const info = RELEVANCE_GRADE_INFO[grade];
---

<span class="inline-flex flex-wrap items-center gap-1.5">
  <a
    class:list={['badge', `grade-${grade}`]}
    href={href(`/methodology#grade-${grade}`)}
    title={info.definition}
  >
    {/* Visible, not sr-only. The short forms are bare adjectives — "None",
        "Randomised", "In vitro" — and a sighted reader given "None" beside a
        drug name has no way to tell whether it means no evidence, no approval
        or no trials. Screen reader users had this context all along. */}
    {short ? <span class="font-normal">Mast-cell evidence:</span> : null}
    {short ? ` ${info.short}` : info.label}
  </a>
  {
    /* Kept separate from the grade on purpose: an approval is for a named
       condition, which establishedFor already lists, and folding it into the
       grade is what made the previous one meaningless. */
    /* The qualification is visible text, never a tooltip. As a bare word beside
       a mast-cell evidence grade, "Approved" reads as approved for MCAS —
       which nothing here is. A title attribute does not fix that: it is
       invisible on touch devices, which is where most patients read this. */
    approved && (
      <span class="badge badge-approved">
        Approved{' '}
        <span class="font-normal">for other conditions</span>
      </span>
    )
  }
</span>
