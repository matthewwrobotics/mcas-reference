---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TreatmentIndex from '../../components/TreatmentIndex.astro';
import { href } from '../../lib/paths';

const entries = (await getCollection('supplements')).filter((e) => !e.data.draft);
---

<Base
  title="Supplements"
  description="Supplements with a published mechanism of action relevant to mast cell activation, each carrying an explicit evidence tier and confound-risk flag."
>
  <h1 class="font-serif text-3xl font-semibold tracking-tight">Supplements</h1>
  <p class="mt-3 max-w-prose" style="color: var(--text-muted);">
    {entries.length} entries, strongest evidence first. Supplements are held to the same
    inclusion bar as medications: a citable published mechanism, never forum consensus.
    In practice most of what clears that bar sits at the mechanistic tier — laboratory
    work rather than human outcome data — and the badges say so plainly rather than
    letting a plausible mechanism read as a result.
    <a href={href('/methodology')}>How the tiers are defined.</a>
  </p>
  <TreatmentIndex entries={entries} basePath="/supplements" />
</Base>
