---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FoodTable, { type FoodRow, type SourceInfo } from '../../components/FoodTable';
import { axisGroups } from '../../lib/derive';
import { RATING_AXES, type RatingAxis } from '../../lib/vocab';
import { href } from '../../lib/paths';

const foodEntries = await getCollection('foods');
const sourceEntries = await getCollection('sources');

const sources: Record<string, SourceInfo> = Object.fromEntries(
  sourceEntries.map((s) => [
    s.id,
    {
      name: s.data.name,
      url: s.data.url,
      redistribution: s.data.redistribution,
      linkReason: s.data.linkReason,
    },
  ]),
);
const isLinkOnly = (id: string) => sources[id]?.redistribution === 'link-only';

const foods: FoodRow[] = foodEntries
  .map((f) => ({
    id: f.id,
    name: f.data.name,
    category: f.data.category,
    form: f.data.form,
    aliases: f.data.aliases,
    note: f.data.note,
    lastVerified: f.data.lastVerified.toISOString(),
    groups: axisGroups(f.data.ratings, isLinkOnly),
    potentialTriggers: f.data.potentialTriggers ?? [],
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

// Only offer axes that something is actually rated on.
const usedAxes: RatingAxis[] = RATING_AXES.filter((a) =>
  foods.some((f) => f.groups.some((g) => g.axis === a)),
);

const disagreementCount = foods.filter((f) =>
  f.groups.some((g) => g.disagreement),
).length;
const linkOnlySources = sourceEntries.filter((s) => s.data.redistribution === 'link-only');
---

<Base
  title="Food & triggers"
  description="A food and trigger directory showing measured-content ratings per source, potential-trigger reports and where published sources disagree."
>
  <h1 class="font-serif text-3xl font-semibold tracking-tight">Food &amp; triggers</h1>

  <div class="prose-body mt-3" style="color: var(--text-muted);">
    <p>
      Ratings are shown <strong>per source</strong> and as low / moderate / high rather
      than as numbers. Both choices are deliberate. Published food lists disagree with
      each other more than patients are usually told: a 2021 review comparing ten
      low-histamine diets found that
      <a href="https://pubmed.ncbi.nlm.nih.gov/33919293/" rel="noopener"
        >only fermented foods were excluded unanimously</a
      >, and that measured histamine content justified fewer than a third of the
      exclusions. Averaging those sources into one number would manufacture a certainty
      the literature does not have.
    </p>
    <p>
      <strong>Potential trigger</strong> is a separate literature signal, not another
      content rating. “Reported” means an opened review explicitly names the food as a
      possible endogenous-histamine trigger while also acknowledging that controlled
      human evidence and the proposed release mechanism are unresolved. A blank cell
      means no qualifying signal is recorded here; it does not promise universal
      tolerance.
    </p>
    <p>
      The conflict you will meet most often is not between two laboratories — it is
      between a <em>food list</em> and a <em>measurement</em>. Citrus is the clearest
      case: 60% of the reviewed diets exclude it, and it contains no detectable
      histamine at all. Those entries carry a note explaining what the exclusion is
      actually based on, because “avoid this” and “this contains that” are different
      claims and deserve to be read differently.
    </p>
    <p>
      {
        disagreementCount === 0
          ? 'Where two citable sources give the same axis different values, the table says “sources differ” and shows both rather than picking a winner. None of the entries currently seeded do.'
          : `Where two citable sources give the same axis different values, the table says “sources differ” and shows both rather than picking a winner — currently on ${disagreementCount} of ${foods.length} entries.`
      }
      {
        disagreementCount > 0 && (
          <span>
            {' '}
            They divide into two kinds, and the difference matters. Some are an artefact
            of measurement: one oxalate review reports per 100 grams and the other bands
            per serving, and servings differ enormously by food. Others are real
            differences in what was measured — the histamine content of avocado, tomato
            or canned sardines genuinely varies by region, cultivar, storage and assay.
            Each entry says which kind it is, because "these two papers used different
            units" and "this food is not the same everywhere" call for different
            responses from a reader.
          </span>
        )
      }
    </p>
  </div>

  <FoodTable client:idle foods={foods} sources={sources} axes={usedAxes} />

  <section class="card mt-10 max-w-prose p-5 text-sm" style="color: var(--text-muted);">
    <h2 class="text-xs font-semibold uppercase tracking-wide" style="color: var(--text-faint);">
      Why some sources show no rating
    </h2>
    <p class="mt-2 leading-relaxed">
      {linkOnlySources.length} of the sources used here are linked rather than restated,
      for reasons that differ between them. For a laboratory database, coarsening a
      measured value into “low” or “high” reduces its precision but not its provenance —
      it is still that database's figure. For a practitioner's list, the value lies in
      which foods it selects and how it groups them, and that selection is the author's
      own work. Either way the build enforces it: an entry that puts a rating against a
      link-only source fails validation, and a link-only source that does not explain
      itself fails too.
    </p>
    <ul class="mt-3 space-y-2">
      {
        linkOnlySources.map((s) => (
          <li>
            <a href={s.data.url} rel="noopener">{s.data.name}</a>
            <span class="block text-xs" style="color: var(--text-faint);">{s.data.terms}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-3">
      <a href={href('/methodology#sources')}>Full source list and terms →</a>
    </p>
  </section>
</Base>
