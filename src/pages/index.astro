---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths';
import { DIRECT_EVIDENCE, DIRECT_EVIDENCE_INFO } from '../lib/vocab';

const medications = (await getCollection('medications')).filter((e) => !e.data.draft);
const supplements = (await getCollection('supplements')).filter((e) => !e.data.draft);
const foods = await getCollection('foods');
const resources = await getCollection('resources');

const treatments = [...medications, ...supplements];
const withOther = treatments.filter((e) => e.data.otherEvidence).length;
const noDirect = treatments.filter((e) => e.data.directEvidence === 'none').length;
const citationCount = treatments.reduce((n, e) => n + e.data.citations.length, 0);

const SECTIONS = [
  {
    path: '/medications',
    label: 'Medications',
    count: medications.length,
    blurb:
      'Mast cell stabilisers, antihistamines, and kinase inhibitors, each with a sourced mechanism and an explicit evidence tier.',
  },
  {
    path: '/supplements',
    label: 'Supplements',
    count: supplements.length,
    blurb:
      'Held to the same bar as medications. Most of what clears it sits at the mechanistic tier, and the badges say so.',
  },
  {
    path: '/foods',
    label: 'Food & triggers',
    count: foods.length,
    blurb:
      'FODMAP, histamine, oxalate and tyramine ratings shown per source, with the basis for each exclusion recorded rather than assumed.',
  },
  {
    path: '/resources',
    label: 'Resources',
    count: resources.length,
    blurb:
      'Diagnostic criteria, key papers, and patient organizations, each tagged with what it is and when it was last checked.',
  },
];
---

<Base
  title="A sourced reference for mast cell activation"
  description="An index of treatments and triggers discussed in mast cell activation disease, recording the published mechanism for each and how strong the evidence behind it actually is."
>
  <section class="max-w-3xl">
    <h1 class="font-serif text-4xl font-semibold leading-tight tracking-tight">
      What is actually known about it, and how well.
    </h1>
    <p class="prose-body mt-4 text-lg" style="color: var(--text-muted);">
      An index of the treatments and triggers discussed in mast cell activation disease.
      For each one it records the published mechanism of action and — the part that is
      usually hard to find — how strong the evidence behind it really is.
    </p>
    <p class="prose-body mt-3" style="color: var(--text-muted);">
      No dosing. No claims that anything works. Nothing gets an entry without a citable
      published mechanism, and every entry wears its evidence grade where you can see it.
      <a href={href('/methodology')}>Those rules are enforced by the build</a>, not by
      good intentions.
    </p>
  </section>

  <ul class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      SECTIONS.map((s) => (
        <li class="card p-5">
          <h2 class="text-lg font-semibold">
            <a href={href(s.path)} class="no-underline hover:underline" style="color: var(--text);">
              {s.label}
            </a>
            <span class="ml-2 text-sm font-normal" style="color: var(--text-faint);">
              {s.count}
            </span>
          </h2>
          <p class="mt-1.5 text-sm" style="color: var(--text-muted);">{s.blurb}</p>
        </li>
      ))
    }
  </ul>

  <section class="mt-12 max-w-3xl">
    <h2 class="font-serif text-2xl font-semibold">How to read an entry</h2>
    <p class="prose-body mt-2" style="color: var(--text-muted);">
      Every entry states two separate things: what has been studied <em>in MCAS</em>, and
      what has been studied <em>somewhere else</em>. Most treatments discussed for this
      condition borrow their credibility from the second — {withOther} of
      {treatments.length} entries here have evidence from a related condition or the
      laboratory, and {noDirect} have nothing published in MCAS at all. Collapsing those
      into one grade is how a randomised trial in chronic urticaria comes to sound like
      a result in MCAS.
    </p>
    <ul class="mt-4 space-y-2">
      {
        DIRECT_EVIDENCE.map((level) => (
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
            <a
              href={href(`/methodology#direct-${level}`)}
              class:list={['badge', `direct-${level}`]}
            >
              {DIRECT_EVIDENCE_INFO[level].label}
            </a>
            <span style="color: var(--text-muted);">{DIRECT_EVIDENCE_INFO[level].definition}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12 max-w-3xl">
    <h2 class="font-serif text-2xl font-semibold">What the site refuses to do</h2>
    <dl class="prose-body mt-3 space-y-4" style="color: var(--text-muted);">
      <div>
        <dt class="font-semibold" style="color: var(--text);">
          Average away a disagreement
        </dt>
        <dd>
          Published food lists contradict each other more than patients are usually told,
          and the sharpest conflicts are between a list and a laboratory: 60% of reviewed
          low-histamine diets exclude citrus, which contains no detectable histamine.
          Ratings are stored and shown per source so those conflicts stay visible instead
          of being averaged into one confident-looking number.
        </dd>
      </div>
      <div>
        <dt class="font-semibold" style="color: var(--text);">
          Let borrowed evidence pass as its own
        </dt>
        <dd>
          MCAS relapses and remits, so improvement after starting something is not
          evidence that the something caused it. Any entry without randomised results in
          MCAS must state in plain words what its evidence cannot establish, and the
          schema rejects any that omits it. A randomised badge additionally requires
          published, evaluable results — a registered protocol or a trial stopped after
          two participants is a fact about a trial, not evidence from one.
        </dd>
      </div>
      <div>
        <dt class="font-semibold" style="color: var(--text);">
          Trust an aggregator for a trial status
        </dt>
        <dd>
          Trial statuses come from ClinicalTrials.gov or the sponsor, never from a
          tracker site — the data model has no field value for one. Aggregators cache the
          last confident-sounding status and show it long after the underlying record has
          gone quiet.
        </dd>
      </div>
      <div>
        <dt class="font-semibold" style="color: var(--text);">Go stale quietly</dt>
        <dd>
          All {citationCount} citations are re-checked weekly by a scheduled job, and every
          entry displays the date a human last verified it. Entries that fall out of date
          say so on their own faces.
        </dd>
      </div>
    </dl>
  </section>
</Base>
