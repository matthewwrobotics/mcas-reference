---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TreatmentIndex from '../../components/TreatmentIndex.astro';
import { href } from '../../lib/paths';

const entries = (await getCollection('medications')).filter((e) => !e.data.draft);
---

<Base
  title="Medications"
  description="Mast cell stabilisers and off-label medications used in mast cell activation disease, each with a sourced mechanism of action and an explicit evidence tier."
>
  <h1 class="font-serif text-3xl font-semibold tracking-tight">Medications</h1>
  <p class="mt-3 max-w-prose" style="color: var(--text-muted);">
    {entries.length} entries, strongest evidence first. Each describes a published
    mechanism of action and nothing beyond it — no dosing, and no claim that anything
    here works. The badge on each entry says what kind of evidence supports it;
    <a href={href('/methodology')}>the tiers are defined here</a>.
  </p>
  <TreatmentIndex entries={entries} basePath="/medications" />
</Base>
