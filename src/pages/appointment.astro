---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AppointmentBuilder, { type SheetItem } from '../components/AppointmentBuilder';
import EmergencyNotice from '../components/EmergencyNotice.astro';
import { href } from '../lib/paths';
import {
  ESTABLISHED_BASIS_INFO,
  MAST_CELL_BASIS_INFO,
  REGULATORY_INFO,
  STUDY_DESIGN_INFO,
  TRIAL_STATUS_LABELS,
} from '../lib/vocab';
import { byClinicalSequence } from '../lib/derive';
import { TREATMENT_CONTEXT_INFO, TREATMENT_STEP_INFO } from '../lib/vocab';

/*
 * The picker's legend for an entry: the same grouping the index uses.
 *
 * This list previously flat-sorted every treatment by a direct-study rank, which
 * floated benzodiazepines, hydroxyurea, sunitinib and tofacitinib above routine
 * antihistamines — purely because direct-but-weak MCAS case reports outrank
 * strong evidence borrowed from another condition. In the one view a patient
 * carries into an appointment, that order reads as a suggestion.
 */
const groupOf = (data: any, section: string): string => {
  if (data.treatmentContext) {
    return `${section} — ${TREATMENT_CONTEXT_INFO[data.treatmentContext as keyof typeof TREATMENT_CONTEXT_INFO].groupTitle}`;
  }
  if (data.treatmentStep) {
    return `${section} — ${data.treatmentStep}. ${TREATMENT_STEP_INFO[data.treatmentStep as keyof typeof TREATMENT_STEP_INFO].label}`;
  }
  return `${section} — outside the stepwise sequence`;
};

const toItems = (entries: any[], section: string): SheetItem[] =>
  [...entries]
    .sort((a, b) => byClinicalSequence(a.data, b.data))
    .map((e) => ({
      id: `${section}:${e.id}`,
      section: groupOf(e.data, section),
      name: e.data.name,
      mechanismClass: e.data.mechanismClass,
      relationshipLabel: MAST_CELL_BASIS_INFO[e.data.mastCellBasis as keyof typeof MAST_CELL_BASIS_INFO].label,
      studyTypeLabels: e.data.studyDesigns.map(
        (design: keyof typeof STUDY_DESIGN_INFO) => STUDY_DESIGN_INFO[design].label,
      ),
      otherEvidence: e.data.establishedFor.length
        ? (['approved-us', 'approved-non-us', 'randomised-trials'] as const)
            .map((b) => {
              const conds = e.data.establishedFor
                .filter((x: any) => x.basis === b)
                .map((x: any) => x.condition);
              return conds.length
                ? `${ESTABLISHED_BASIS_INFO[b].label} ${conds.join(', ')}`
                : null;
            })
            .filter(Boolean)
            .join('; ')
        : undefined,
      regulatoryLabel: REGULATORY_INFO[e.data.regulatory as keyof typeof REGULATORY_INFO].label,
      evidenceLimits: e.data.evidenceLimits,
      trials: e.data.trials.map((trial: any) => ({
        nctId: trial.nctId,
        condition: trial.condition,
        statusLabel: TRIAL_STATUS_LABELS[trial.status as keyof typeof TRIAL_STATUS_LABELS],
      })),
      citations: e.data.citations.map((c: any) => ({
        title: c.title,
        url: c.url,
        pmid: c.pmid,
      })),
    }));

const items: SheetItem[] = [
  ...toItems((await getCollection('medications')).filter((e) => !e.data.draft), 'Medications'),
  ...toItems((await getCollection('supplements')).filter((e) => !e.data.draft), 'Supplements'),
];
---

<Base
  title="Appointment sheet"
  description="Build a one-page printable summary of selected entries — mechanism, mast-cell relationship, study types and citations — to take to a clinical appointment."
>
  <div class="print-controls">
    <h1 class="font-serif text-3xl font-semibold tracking-tight">Appointment sheet</h1>
    <div class="prose-body mt-3" style="color: var(--text-muted);">
      <p>
        Pick the entries you want to raise. The sheet prints each one on a single
        page, with its mechanism, mast-cell relationship, cited study types and citations.
      </p>
      <p>
        It is not a request list. The aim is to arrive with the information a
        clinician would check anyway, already sourced, so the conversation starts
        further along.
      </p>
      <p>
        Every printed entry keeps those facts separate from the conditions for which
        the treatment is approved or trialled. An approval in another condition is not
        evidence in this one, and a sheet that blurred the two would be worse than no
        sheet.
      </p>
      <p class="text-sm" style="color: var(--text-faint);">
        Looking for someone to bring it to? <a href={href('/advocacy#finding-a-clinician')}>Finding
        a clinician</a> is on the tests and diagnosis page. That page also explains
        which tests support the criteria and when those tests need to be drawn.
      </p>
    </div>

    <div class="mt-5 print-hide">
      <EmergencyNotice />
    </div>
  </div>

  <AppointmentBuilder client:load items={items} />
</Base>
