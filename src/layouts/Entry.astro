---
import Base from './Base.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import StatusBadge from '../components/StatusBadge.astro';
import ConfoundFlag from '../components/ConfoundFlag.astro';
import TrialStatus from '../components/TrialStatus.astro';
import CitationList from '../components/CitationList.astro';
import LastVerified from '../components/LastVerified.astro';
import { EVIDENCE_TIER_INFO } from '../lib/vocab';
import { href } from '../lib/paths';

interface Props {
  entry: any;
  backHref: string;
  backLabel: string;
}
const { entry, backHref, backLabel } = Astro.props;
const d = entry.data;
const tierInfo = EVIDENCE_TIER_INFO[d.evidenceTier as keyof typeof EVIDENCE_TIER_INFO];
---

<Base title={d.name} description={d.summary}>
  <a href={href(backHref)} class="text-sm">← {backLabel}</a>

  <header class="mt-4">
    <h1 class="font-serif text-3xl font-semibold tracking-tight">{d.name}</h1>
    {
      d.aliases.length > 0 && (
        <p class="mt-1 text-sm" style="color: var(--text-faint);">
          Also known as {d.aliases.join(', ')}
        </p>
      )
    }
    <p class="mt-3 max-w-prose text-lg" style="color: var(--text-muted);">{d.summary}</p>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <EvidenceBadge tier={d.evidenceTier} />
      <StatusBadge status={d.regulatory} />
      <span class="badge badge-neutral">{d.mechanismClass}</span>
      <LastVerified date={d.lastVerified} />
    </div>

    <p class="mt-3 max-w-prose text-sm" style="color: var(--text-faint);">
      <strong style="color: var(--text-muted);">What that evidence tier means:</strong>
      {tierInfo.definition}
    </p>
  </header>

  <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wide" style="color: var(--text-faint);">
        Mechanism of action
      </h2>
      <div class="prose-body mt-2">
        <slot />
      </div>

      {
        d.offLabelRationale && (
          <section class="mt-8">
            <h2 class="text-xs font-semibold uppercase tracking-wide" style="color: var(--text-faint);">
              Approved elsewhere — off-label rationale
            </h2>
            <p class="prose-body mt-2">{d.offLabelRationale}</p>
          </section>
        )
      }

      <section class="mt-8">
        <h2 class="text-xs font-semibold uppercase tracking-wide" style="color: var(--text-faint);">
          Sources
        </h2>
        <CitationList citations={d.citations} />
      </section>
    </div>

    <aside class="space-y-4">
      {d.confoundRisk && <ConfoundFlag level={d.confoundRisk.level} note={d.confoundRisk.note} />}
      {
        d.trial && (
          <TrialStatus
            nctId={d.trial.nctId}
            status={d.trial.status}
            statusSource={d.trial.statusSource}
            verified={d.trial.verified}
          />
        )
      }
      <div class="card p-4 text-sm" style="color: var(--text-muted);">
        <h2 class="text-xs font-semibold uppercase tracking-wide" style="color: var(--text-faint);">
          What this page does not say
        </h2>
        <p class="mt-2 leading-relaxed">
          No dosing, and no claim that this works. The entry describes a published
          mechanism and records the strength of the evidence behind it — nothing further.
          <a href={href('/methodology')}>Why the site is built this way.</a>
        </p>
      </div>
    </aside>
  </div>
</Base>
