---
import Base from './Base.astro';
import EvidenceRows from '../components/EvidenceRows.astro';
import EvidenceLimits from '../components/EvidenceLimits.astro';
import TrialList from '../components/TrialList.astro';
import GradeBadge from '../components/GradeBadge.astro';
import CitationList from '../components/CitationList.astro';
import LastVerified from '../components/LastVerified.astro';
import { MAST_CELL_BASIS_INFO, TREATMENT_STEP_INFO } from '../lib/vocab';
import { relevanceGrade } from '../lib/derive';
import { href } from '../lib/paths';

interface Props {
  entry: any;
  backHref: string;
  backLabel: string;
}
const { entry, backHref, backLabel } = Astro.props;
const d = entry.data;
const basisInfo = MAST_CELL_BASIS_INFO[d.mastCellBasis as keyof typeof MAST_CELL_BASIS_INFO];
---

<Base title={d.name} description={d.summary}>
  <a href={href(backHref)} class="text-sm">← {backLabel}</a>

  <header class="mt-4">
    <h1 class="font-serif text-3xl font-semibold tracking-tight">{d.name}</h1>
    <p class="mt-1 text-sm" style="color: var(--text-faint);">
      {d.mechanismClass}{d.aliases.length > 0 && <span> · also known as {d.aliases.join(', ')}</span>}
    </p>
    <p class="mt-3 max-w-prose text-lg" style="color: var(--text-muted);">{d.summary}</p>

    <p class="mt-4">
      <GradeBadge
        grade={relevanceGrade(d)}
        approved={d.establishedFor.some((e: any) => e.basis.startsWith('approved'))}
      />
    </p>

    <EvidenceRows
      basis={d.mastCellBasis}
      studyDesigns={d.studyDesigns}
      establishedFor={d.establishedFor}
      specialistUse={d.specialistUse}
      regulatory={d.regulatory}
    />

    <p class="mt-4 max-w-prose text-sm" style="color: var(--text-faint);">
      <strong style="color: var(--text-muted);">What “studied in” means here:</strong>
      {basisInfo.definition}
      {
        d.treatmentStep && (
          <span>
            {' '}A 2025 practical-management review places this at step
            {' '}{d.treatmentStep} of the sequence it describes —
            {' '}{TREATMENT_STEP_INFO[d.treatmentStep as 1].described}. That is what the
            review reports, not a recommendation from this site.
          </span>
        )
      }
    </p>
  </header>

  <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wide" style="color: var(--text-faint);">
        Mechanism of action
      </h2>
      <div class="prose-body mt-2">
        <slot />
      </div>

      {
        d.offLabelRationale && (
          <section class="mt-8">
            <h2 class="text-xs font-semibold uppercase tracking-wide" style="color: var(--text-faint);">
              Approved elsewhere — off-label rationale
            </h2>
            <p class="prose-body mt-2">{d.offLabelRationale}</p>
          </section>
        )
      }

      <section class="mt-8">
        <h2 class="text-xs font-semibold uppercase tracking-wide" style="color: var(--text-faint);">
          Sources
        </h2>
        <CitationList citations={d.citations} />
      </section>
    </div>

    <aside class="space-y-4">
      {d.evidenceLimits && <EvidenceLimits text={d.evidenceLimits} />}
      {d.trials.length > 0 && <TrialList trials={d.trials} />}
      <div class="card p-4 text-sm" style="color: var(--text-muted);">
        <h2 class="text-xs font-semibold uppercase tracking-wide" style="color: var(--text-faint);">
          What this page does not say
        </h2>
        <p class="mt-2 leading-relaxed">
          No dosing, and no claim that this works. The entry describes a published
          mechanism and records the strength of the evidence behind it — nothing further.
          <a href={href('/methodology')}>Why the site is built this way.</a>
        </p>
      </div>
      <p class="text-xs" style="color: var(--text-faint);">
        <LastVerified date={d.lastVerified} />
      </p>
    </aside>
  </div>
</Base>
